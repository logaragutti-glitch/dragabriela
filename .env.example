# Copie este arquivo para ".env" (que não é versionado) e preencha com os valores reais.
# No Vercel, estas mesmas variáveis vão em Project Settings → Environment Variables — não neste arquivo.

# Project Settings → API, no painel do Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Escolha uma senha longa e aleatória — protege o endpoint /api/export.csv
ADMIN_TOKEN=

# Só necessário rodando localmente (o Vercel define a porta sozinho)
PORT=3010
