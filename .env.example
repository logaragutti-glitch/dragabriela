# Copie este arquivo para ".env" (não é versionado) e preencha com os valores reais.
# No Vercel, essa variável já vem preenchida automaticamente pela integração Neon
# (Storage → Marketplace → Neon) — não precisa copiar nada lá.

# Pra rodar localmente, gere este arquivo automaticamente com:
#   npx vercel link          (conecta esta pasta ao projeto criado no Vercel)
#   npx vercel env pull .env (baixa as variáveis reais, incluindo DATABASE_URL)
DATABASE_URL=

# Escolha uma senha longa e aleatória — protege o endpoint /api/export.csv
ADMIN_TOKEN=

# Só necessário rodando localmente (o Vercel define a porta sozinho)
PORT=3010
